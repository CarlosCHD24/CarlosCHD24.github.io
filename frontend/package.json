{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "validate:export": "node scripts/validate-static-export.mjs",
    "validate:security-baseline": "node scripts/validate-security-baseline.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "test": "npm run test:component && npm run build && npm run validate:export && npm run test:e2e",
    "test:component": "vitest run",
    "test:component:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:ci": "npm run lint && npm run test:component && npm run build && npm run validate:export && npm run test:e2e"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
